# OpenIRM Environment Configuration Example

# API Configuration
PORT=8000
HOST=0.0.0.0
ENVIRONMENT=development
LOG_LEVEL=INFO

# LLM Provider Credentials
# Groq API Key (Free tier: https://console.groq.com/)
GROQ_API_KEY=gsk_your_groq_api_key_here
LLM_PROVIDER=groq
LLM_MODEL=llama-3.3-70b-versatile

# Ollama Provider (Secondary local fallback)
OLLAMA_BASE_URL=http://localhost:11434

# Database Configuration (SQLite default for local dev)
DATABASE_URL=sqlite:///./openirm.db
# PostgreSQL (Production / Neon / Supabase free tier):
# DATABASE_URL=postgresql://user:password@ep-cool-site-123456.us-east-2.aws.neon.tech/openirm?sslmode=require

# Data Paths
DATA_DIR=backend/data
